{
  "name": "dayz-admin-tools",
  "productName": "DayZ Admin Tools",
  "version": "0.1.72",
  "description": "Desktop app to install, update, run and monitor a DayZ Standalone dedicated server with Steam Workshop mod management.",
  "main": "src/main/main.js",
  "author": "chris",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always",
    "icon": "electron build/gen-icon.js",
    "maps": "electron scripts/prepare-maps.js",
    "test": "node test/run.js",
    "predist": "node test/run.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.chris.dayzservertool",
    "productName": "DayZ Admin Tools",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "DayZ-Admin-Tools-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "DayZ-Admin-Tools-Setup-${version}.${ext}",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "DayZ-Admin-Tools-${version}-portable.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "WilksCheckov",
      "repo": "dayz-server-tool"
    },
    "extraResources": [
      {
        "from": "build-maps",
        "to": "maps",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "acme-client": "^5.4.0",
    "basic-ftp": "^6.2.3",
    "codemirror": "^5.65.21",
    "discord.js": "^14.27.0",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.11.2",
    "jpeg-js": "^0.4.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WilksCheckov/dayz-server-tool.git"
  },
  "overrides": {
    "node-forge": "^1.4.0"
  }
}
